# realty_app 云端 APK 打包 —— **示例**
#
# 启用步骤：
#   1. 注册 DCloud 开发者账号，认领 appid，把它写到 src/manifest.json
#   2. 把这个文件改名为 apk-cloud-build.yml（去掉 .example）
#   3. 在 GitHub Repo Settings → Secrets 配置：
#        DCLOUD_USER     DCloud 账号（手机号/邮箱）
#        DCLOUD_PASSWORD DCloud 密码
#   4. 推一次变更或手动 workflow_dispatch 触发
#
# 与 wgt 流水线（build-app-wgt.yml）独立，只在 .yml / 静态资源变更时跑。
# DCloud 云端打包有每日次数限制；非频繁发版足够了。

name: realty_app cloud apk (DCloud)

on:
  push:
    branches: [main]
    paths:
      - "realty_app/**"
      - ".github/workflows/apk-cloud-build.yml"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: realty_app-cloud-apk
  cancel-in-progress: true

jobs:
  cloud-apk:
    name: DCloud 云端打包并上传 Release
    runs-on: ubuntu-latest
    timeout-minutes: 25
    defaults:
      run:
        working-directory: realty_app
    steps:
      - name: 拉代码
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: true

      - name: 设 Node.js
        uses: actions/setup-node@v5
        with:
          node-version: "20"

      - name: 装依赖
        run: npm ci

      - name: 编译 wgt（云端打包前必须先生成 wgt）
        run: npm run build:app

      # 真正的"登录 + 触发云端打包"需要 DCloud SDK / 二次验证；这里给出最简模板占位
      # 你接 DCloud 官方 HTTP API 时需自行实现登录（带滑块）或预先把 cookie 塞到 Secrets
      - name: 占位：调用 DCloud 云端打包
        if: ${{ false }} # 默认禁用；启用时改为 if: ${{ true }} 并补完下面的命令
        run: |
          echo "请在脚本里实现 DCloud /api/build 的登录 + 触发逻辑"
          echo "用户: ${{ secrets.DCLOUD_USER }}"
          echo "密码: 长度 $(echo -n '${{ secrets.DCLOUD_PASSWORD }}' | wc -c)"

      - name: 占位：上传产物到 Release
        if: ${{ false }}
        uses: softprops/action-gh-release@v2
        with:
          files: |
            realty_app/dist/build/app-release.apk
            realty_app/dist/build/app-release-signed.apk
          generate_release_notes: true
          fail_on_unmatched_files: false
